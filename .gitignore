# ===== Python 缓存 =====
__pycache__/
*.py[cod]
*$py.class
*.so

# ===== 虚拟环境 =====
venv/
env/
.venv/
ENV/

# ===== IDE 配置 =====
.idea/
.vscode/

# ===== Django 数据库（运行时生成，不提交） =====
db.sqlite3
*.sqlite3

# ===== YOLO 运行时生成的检测结果（每次检测都会新增，不提交） =====
runs/detect/

# ===== 用户上传的检测图片（保留目录，忽略内容） =====
static/images/detect/*
!static/images/detect/.gitkeep

# ===== 日志 / 临时文件 =====
*.log
*.tmp

# ===== 系统文件 =====
.DS_Store
Thumbs.db
